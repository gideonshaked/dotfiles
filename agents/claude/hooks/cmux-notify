#!/usr/bin/env bash
#
# Surfaces this session in the cmux sidebar.
#
# Two delivery paths, because they work in different places.
#
# The `cmux` CLI exists on the Mac, and on a remote reached with `cmux ssh`,
# which uploads a relay daemon and bootstraps a `cmux` there whose calls run
# against the local instance. It carries workspace and surface attribution, so
# it is preferred where it exists.
#
# An OSC escape sequence needs nothing installed on the far end. It travels in
# the terminal stream, so it survives plain ssh, mosh, and anything else that
# carries bytes back to the terminal. It must go to /dev/tty: a hook's stdout
# is captured by Claude Code and never reaches the terminal.

set -o pipefail

command -v jq >/dev/null 2>&1 || exit 0

notify() {
    local title="$1" body="$2"

    if command -v cmux >/dev/null 2>&1; then
        cmux notify --title "$title" --body "$body" >/dev/null 2>&1 && return 0
    fi

    # The redirect itself fails when the process has no controlling terminal,
    # and that failure is the shell's, so the whole block needs the guard.
    { printf '\033]777;notify;%s;%s\a' "$title" "$body" >/dev/tty; } 2>/dev/null || true
}

event="$(cat)"

case "$(printf '%s' "$event" | jq -r '.hook_event_name // ""')" in
    Stop)
        notify "Claude Code" "Turn complete"
        ;;
    Notification)
        notify "Claude Code" "$(printf '%s' "$event" | jq -r '.message // "Needs input"')"
        ;;
esac

exit 0
