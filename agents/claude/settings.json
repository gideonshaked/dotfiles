{
  "skillListingBudgetFraction": 0.015,
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "claude-validate",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/bin/dotfiles-npx -y ccstatusline@latest --hook"
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/bin/dotfiles-npx -y ccstatusline@latest --hook"
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/bin/dotfiles-npx -y ccstatusline@latest --hook"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/bin/dotfiles-npx -y ccstatusline@latest --hook"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/bin/dotfiles-npx -y ccstatusline@latest --hook"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/bin/dotfiles-npx -y ccstatusline@latest --hook"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "$HOME/bin/dotfiles-npx -y ccstatusline@latest",
    "padding": 0
  },
  "enabledPlugins": {
    "agentic-peer-review@agentic-peer-review": true,
    "beads@beads-marketplace": true,
    "context7@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "mm-cli-skill@vlmrun-skills": true,
    "scientific-problem-selection@life-sciences": true,
    "frontend-design@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "playground@claude-plugins-official": true,
    "impeccable@impeccable": true,
    "cdd-utils@octant-agent-plugin-marketplace": true,
    "octant-app-store@octant-agent-plugin-marketplace": true,
    "octant-chem-utils@octant-agent-plugin-marketplace": true,
    "octant-comp-chem@octant-agent-plugin-marketplace": true,
    "pyright-lsp@claude-plugins-official": true,
    "octomind-rolling@octant-agent-plugin-marketplace": true,
    "databricks@claude-plugins-official": true,
    "i-have-adhd@i-have-adhd": true
  },
  "extraKnownMarketplaces": {
    "agentic-peer-review": {
      "source": {
        "source": "github",
        "repo": "gideonshaked/agentic-peer-review"
      }
    },
    "beads-marketplace": {
      "source": {
        "source": "github",
        "repo": "steveyegge/beads"
      }
    },
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "huggingface-skills": {
      "source": {
        "source": "github",
        "repo": "huggingface/skills"
      }
    },
    "vlmrun-skills": {
      "source": {
        "source": "github",
        "repo": "vlm-run/skills"
      }
    },
    "life-sciences": {
      "source": {
        "source": "git",
        "url": "https://github.com/anthropics/life-sciences.git"
      }
    },
    "impeccable": {
      "source": {
        "source": "github",
        "repo": "pbakaus/impeccable"
      }
    },
    "octant-agent-plugin-marketplace": {
      "source": {
        "source": "github",
        "repo": "octantbio/octant-agent-plugin-marketplace"
      },
      "autoUpdate": true
    },
    "i-have-adhd": {
      "source": {
        "source": "github",
        "repo": "ayghri/i-have-adhd"
      }
    }
  },
  "spinnerTipsEnabled": false,
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      "Sacrificing a rubber duck to the code gods",
      "Committing crimes against clean code",
      "Doing unspeakable things to your codebase",
      "Making the linter cry",
      "Violating every best practice known to man",
      "Making you regret every decision that led to this moment",
      "Turning your code into a dumpster fire",
      "Killing all of the joy in your life, one line of code at a time",
      "Quiet quitting"
    ]
  },
  "effortLevel": "high",
  "pluginConfigs": {
    "octomind-rolling@octant-agent-plugin-marketplace": {
      "options": {
        "user_name": "Gideon",
        "slack_username": "gideon",
        "email": "gideon@octant.bio"
      }
    }
  },
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "preferredNotifChannel": "kitty",
  "autoCompactEnabled": false,
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "voiceEnabled": true
}
