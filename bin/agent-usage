#!/usr/bin/env python3
"""Report skill invocations and MCP tool calls across Claude Code transcripts.

Every pruning decision in this repo rests on this measurement. Keep it runnable so
"is that skill actually used" and "did the exa fix work" stay one-line questions.

Usage:
    agent-usage [--since YYYY-MM-DD]
"""

import argparse
import collections
import datetime as dt
import json
import pathlib
import sys

ROOT = pathlib.Path.home() / ".claude" / "projects"


def iter_tool_uses(since):
    """Yield (session_file, tool_use_block) for every tool call in every transcript."""
    for path in ROOT.rglob("*.jsonl"):
        if since and dt.date.fromtimestamp(path.stat().st_mtime) < since:
            continue
        with path.open(errors="replace") as handle:
            for line in handle:
                if '"tool_use"' not in line:
                    continue
                try:
                    record = json.loads(line)
                except json.JSONDecodeError:
                    continue
                content = (record.get("message") or {}).get("content") or []
                for block in content:
                    if isinstance(block, dict) and block.get("type") == "tool_use":
                        yield path, block


def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--since", type=dt.date.fromisoformat, metavar="YYYY-MM-DD")
    args = parser.parse_args()

    if not ROOT.is_dir():
        print(f"no transcripts at {ROOT}", file=sys.stderr)
        return 1

    skills = collections.Counter()
    skill_sessions = collections.defaultdict(set)
    servers = collections.Counter()
    sessions = set()

    for path, block in iter_tool_uses(args.since):
        sessions.add(path)
        name = block.get("name", "")
        if name == "Skill":
            skill = (block.get("input") or {}).get("skill")
            if skill:
                skills[skill] += 1
                skill_sessions[skill].add(path)
        elif name.startswith("mcp__"):
            parts = name.split("__")
            if len(parts) > 1:
                servers[parts[1]] += 1

    scope = f" since {args.since}" if args.since else ""
    print(f"{len(sessions)} sessions{scope}\n")

    print(f"{'skill':44} {'calls':>6} {'sessions':>9}")
    print("-" * 62)
    for skill, count in skills.most_common():
        print(f"{skill:44} {count:>6} {len(skill_sessions[skill]):>9}")
    if not skills:
        print("(none)")

    print(f"\n{'mcp server':44} {'calls':>6}")
    print("-" * 52)
    for server, count in servers.most_common():
        print(f"{server:44} {count:>6}")
    if not servers:
        print("(none)")

    return 0


if __name__ == "__main__":
    sys.exit(main())
