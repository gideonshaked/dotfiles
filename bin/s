#!/usr/bin/env bash
#
# SSH wrapper with optional dotfiles bootstrapping.
#
# Usage: s [options] <host> [ssh args...]

set -e

usage() {
    echo "Usage: s [options] <host> [ssh args...]"
    echo ""
    echo "SSH wrapper with optional dotfiles bootstrapping."
    echo ""
    echo "Options:"
    echo "  --install-dotfiles    Install dotfiles (or update if already present)"
    echo "  --reinstall-dotfiles  Delete existing dotfiles and reinstall from scratch"
    echo "  --update-dotfiles     Pull latest changes and re-run install"
    echo "  --install-terminfo    Copy this terminal's terminfo entry to the host"
    echo "  -h, --help            Show this help message"
}

# Terminfo is installed once per host rather than shipped on every connection.
# A per-connection wrapper (kitty's ssh kitten, ghostty's ssh-terminfo) only
# fires when it wraps the literal ssh command, so `gcloud compute ssh`, a
# cloudflared ProxyCommand and any jump host bypass it and leave the remote
# with an unknown TERM. An entry under ~/.terminfo is found however the
# connection is made.
install_terminfo() {
    if [ -z "$TERM" ] || [ "$TERM" = "dumb" ]; then
        echo "No usable TERM to install" >&2
        return 0
    fi
    echo "Installing $TERM terminfo..."
    if infocmp -x "$TERM" | ssh "$@" 'mkdir -p ~/.terminfo && tic -x -o ~/.terminfo -'; then
        echo "terminfo OK"
    else
        echo "terminfo install failed; remote TUIs may render poorly" >&2
    fi
}

action=""
args=()
for arg in "$@"; do
    case "$arg" in
        -h|--help) usage; exit 0 ;;
        --install-dotfiles) action="install" ;;
        --reinstall-dotfiles) action="reinstall" ;;
        --update-dotfiles) action="update" ;;
        --install-terminfo) action="terminfo" ;;
        --*) echo "Unknown option: $arg" >&2; usage >&2; exit 1 ;;
        *) args+=("$arg") ;;
    esac
done
set -- "${args[@]}"

if [ -z "$1" ]; then
    usage >&2
    exit 1
fi

case "$action" in
    install)
        install_terminfo "$@"
        ssh "$@" bash << 'EOF'
if [ -d ~/dotfiles ]; then
    echo "Updating dotfiles..."
    cd ~/dotfiles && bin/dotfiles update
else
    echo "Installing dotfiles..."
    git clone https://github.com/gideonshaked/dotfiles ~/dotfiles
    cd ~/dotfiles && ./install --profile server
fi
EOF
        ;;
    reinstall)
        install_terminfo "$@"
        ssh "$@" bash << 'EOF'
echo "Reinstalling dotfiles..."
rm -rf ~/dotfiles
git clone https://github.com/gideonshaked/dotfiles ~/dotfiles
cd ~/dotfiles && ./install --profile server
EOF
        ;;
    update)
        ssh "$@" bash << 'EOF'
if [ -d ~/dotfiles ]; then
    cd ~/dotfiles && bin/dotfiles update
else
    echo "Dotfiles not installed on this host"
fi
EOF
        ;;
    terminfo)
        install_terminfo "$@"
        exit 0
        ;;
esac

ssh "$@"
