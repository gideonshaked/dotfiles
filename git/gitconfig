[user]
	email = gideonshaked@gmail.com
	name = Gideon Shaked

[core]
	excludesfile = ~/.gitignore

[credential]
	helper = osxkeychain

[credential "https://github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential

[credential "https://gist.github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential

[pull]
	ff = only

[push]
	default = upstream

# Disables git's dubious-ownership check everywhere. Added to silence errors on
# shared or container-mounted repos; it is a real security tradeoff.
[safe]
	directory = *

# Global log format. Affects every `git log` including scripts that parse it.
[format]
	pretty = %C(yellow)%h%Creset %C(magenta)%cd%Creset %an <%ae> %C(cyan)%s%Creset%C(yellow)%d%Creset%n
