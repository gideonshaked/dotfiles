# Dependencies of this repository's configuration, and nothing else. Anything
# here is required by a file under this repo; a package that is merely
# installed on some machine does not belong.
#
# `brew bundle dump` would overwrite this with the full machine inventory, so
# `dotfiles brew` installs from it but nothing regenerates it.

# Prompt, history and fuzzy matching. terminal/shellrc sources all three, for
# both zsh and bash.
brew "starship"
brew "atuin"
brew "fzf"

# zsh-only completions and highlighting. terminal/shellrc guards each source
# with a file test, so a machine without them still starts.
brew "fzf-tab"
brew "zsh-autosuggestions"
brew "zsh-syntax-highlighting"
brew "zsh-completions"

# setup/scripts/install-claude-plugins reads ~/.claude/settings.json with jq,
# and bin/claude-validate parses its hook payload with it. Without jq, plugins
# do not install and the PostToolUse hook does nothing.
brew "jq"

# uvx runs the ssh-mcp server registered by setup/scripts/install-agent-mcps.
brew "uv"

# npx runs ccstatusline for the Claude statusLine and the gcloud MCP server.
brew "node"

# agents/claude/hooks/claude-validate checks edited Python with it.
brew "ruff"

# .pre-commit-config.yaml drives the repo's git hooks and the lint workflow.
brew "pre-commit"

# git/gitconfig uses `gh auth git-credential` as the GitHub credential helper.
brew "gh"

# ssh/private.d/umich reaches nubio through a Cloudflare tunnel.
brew "cloudflared"

# vscode/settings.json points shellcheck.executablePath and
# bashIde.shellcheckPath at this.
brew "shellcheck"

# Casks and editor extensions exist only on macOS; a Brewfile is Ruby, so the
# Linux install skips this block rather than failing on it.
if OS.mac?
  # vscode/settings.json sets editor.fontFamily to "Hack Nerd Font".
  cask "font-hack-nerd-font"

  # The editor whose settings and keybindings this repo links.
  cask "visual-studio-code"

  # ssh/platform.d/01-macos points IdentityAgent at this app's agent socket.
  cask "1password"

  vscode "davidanson.vscode-markdownlint"
  vscode "james-yu.latex-workshop"
  vscode "mads-hartmann.bash-ide-vscode"
  vscode "mousavian.ssh-config-syntax-highlighter"
  vscode "ms-python.debugpy"
  vscode "ms-python.python"
  vscode "ms-python.vscode-pylance"
  vscode "ms-python.vscode-python-envs"
  vscode "ms-toolsai.jupyter"
  vscode "ms-toolsai.jupyter-keymap"
  vscode "ms-toolsai.jupyter-renderers"
  vscode "ms-toolsai.vscode-jupyter-cell-tags"
  vscode "ms-toolsai.vscode-jupyter-slideshow"
  vscode "pkief.material-icon-theme"
  vscode "tamasfe.even-better-toml"
  vscode "timonwong.shellcheck"
  vscode "yzane.markdown-pdf"
  vscode "yzhang.markdown-all-in-one"
end
