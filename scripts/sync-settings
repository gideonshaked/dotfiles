#!/usr/bin/env python3
"""Copy shared settings from the active Claude profile to the other one.

/config and /model write to ~/.claude/settings.json, which symlinks to whichever
profile is installed. The other profile silently falls behind. This copies every
key except the three that are meant to differ, so the two files stay in step.

Run it after changing settings through the Claude Code UI.
"""

import json
import pathlib
import sys

REPO = pathlib.Path(__file__).resolve().parent.parent
PROFILES = {
    "personal": REPO / "agents" / "claude" / "settings.personal.json",
    "work": REPO / "agents" / "claude" / "settings.work.json",
}
PROFILE_SPECIFIC = {"enabledPlugins", "extraKnownMarketplaces", "pluginConfigs"}
LIVE = pathlib.Path.home() / ".claude" / "settings.json"


def active_profile():
    """Which profile ~/.claude/settings.json currently points at."""
    if not LIVE.is_symlink():
        return None
    target = LIVE.resolve()
    for name, path in PROFILES.items():
        if path.resolve() == target:
            return name
    return None


def main():
    source = active_profile()
    if source is None:
        print("~/.claude/settings.json does not link to a known profile", file=sys.stderr)
        return 1

    src = json.loads(PROFILES[source].read_text())
    changed = []
    for name, path in PROFILES.items():
        if name == source:
            continue
        dst = json.loads(path.read_text())
        for key, value in src.items():
            if key in PROFILE_SPECIFIC:
                continue
            if dst.get(key) != value:
                dst[key] = value
                changed.append(f"{name}.{key}")
        for key in list(dst):
            if key not in src and key not in PROFILE_SPECIFIC:
                del dst[key]
                changed.append(f"{name}.{key} (removed)")
        path.write_text(json.dumps(dst, indent=2) + "\n")

    if changed:
        print(f"synced from {source}: " + ", ".join(changed))
    else:
        print(f"already in sync (active profile: {source})")
    return 0


if __name__ == "__main__":
    sys.exit(main())
