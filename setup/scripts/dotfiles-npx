#!/usr/bin/env bash

set -euo pipefail

# Reached through a symlink at ~/.claude/bin, so the script's own path must be
# resolved before lib/ can be found beside it.
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [ "${SOURCE#/}" = "$SOURCE" ] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"

# shellcheck disable=SC1091
. "$SCRIPT_DIR/lib/npx.sh"

if ! dotfiles_npx_activate; then
    echo "npx not found. Run dotfiles update or setup/scripts/ensure-npx first." >&2
    exit 127
fi

exec npx "$@"
