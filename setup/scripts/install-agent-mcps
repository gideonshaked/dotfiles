#!/usr/bin/env bash

set -euo pipefail

CONTEXT7_SECRETS="${HOME}/.shell-secrets"
EXA_URL="https://mcp.exa.ai/mcp"
GCLOUD_PACKAGE="@google-cloud/gcloud-mcp"
SSH_MCP_PACKAGE="slepp-ssh-mcp"
NPX_CMD="${DOTFILES_NPX:-${HOME}/bin/dotfiles-npx}"
GCLOUD_MCP_COMMAND='exec "$HOME/bin/dotfiles-npx" -y @google-cloud/gcloud-mcp'
PATH="${HOME}/bin:${HOME}/.local/bin:${HOME}/.bun/bin:${HOME}/.cargo/bin:/opt/homebrew/bin:/usr/local/bin:${PATH}"
export PATH

export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
if [ -s "$NVM_DIR/nvm.sh" ]; then
    # shellcheck disable=SC1091
    . "$NVM_DIR/nvm.sh"
    nvm use --silent default >/dev/null 2>&1 || nvm use --silent --lts >/dev/null 2>&1 || true
fi

claude_has() {
    claude mcp get "$1" 2>/dev/null | grep -qF "$2"
}

install_claude_mcp() {
    if ! which claude >/dev/null 2>&1; then
        echo "claude CLI not found, skipping MCPs (non-fatal)"
        return 0
    fi

    if ! claude_has exa "URL: $EXA_URL"; then
        claude mcp remove exa -s user >/dev/null 2>&1 || true
        claude mcp add --scope user --transport http exa "$EXA_URL" >/dev/null 2>&1 || echo "Exa MCP setup failed (non-fatal)"
    fi

    if ! claude_has gcloud "dotfiles-npx" || ! claude_has gcloud "$GCLOUD_PACKAGE"; then
        claude mcp remove gcloud -s user >/dev/null 2>&1 || true
        claude mcp add --scope user gcloud -- bash -lc "$GCLOUD_MCP_COMMAND" >/dev/null 2>&1 || echo "gcloud MCP setup failed (non-fatal)"
    fi

    # agents/claude/skills/ssh names seven mcp__ssh-mcp__* tools. Without this
    # server the skill installs and every tool it references is absent.
    if ! claude_has ssh-mcp "$SSH_MCP_PACKAGE"; then
        claude mcp remove ssh-mcp -s user >/dev/null 2>&1 || true
        claude mcp add --scope user ssh-mcp -- uvx --from "$SSH_MCP_PACKAGE" ssh-mcp >/dev/null 2>&1 || echo "ssh-mcp setup failed (non-fatal)"
    fi
}

# Remove MCP servers that are no longer part of this configuration.
prune_retired_mcps() {
    which claude >/dev/null 2>&1 || return 0
    for server in aws-api aws-pricing aws-knowledge; do
        claude mcp remove "$server" -s user >/dev/null 2>&1 || true
    done
}

write_context7_secret() {
    local key="$1"
    local tmp

    [ -n "$key" ] || return 0

    mkdir -p "$(dirname "$CONTEXT7_SECRETS")"
    touch "$CONTEXT7_SECRETS"
    chmod 600 "$CONTEXT7_SECRETS"

    tmp="$(mktemp)"
    grep -v '^export CONTEXT7_API_KEY=' "$CONTEXT7_SECRETS" > "$tmp" || true
    printf 'export CONTEXT7_API_KEY=%q\n' "$key" >> "$tmp"
    mv -f "$tmp" "$CONTEXT7_SECRETS"
    chmod 600 "$CONTEXT7_SECRETS"
}

install_context7() {
    if [ "${DOTFILES_INSTALL_CONTEXT7:-}" != "1" ] && [ -z "${CONTEXT7_API_KEY:-}" ]; then
        echo "Context7 setup skipped. Set DOTFILES_INSTALL_CONTEXT7=1 or CONTEXT7_API_KEY to run it."
        return 0
    fi

    if ! command -v "$NPX_CMD" >/dev/null 2>&1; then
        echo "npx not found, skipping Context7 setup (non-fatal)"
        return 0
    fi

    if [ -n "${CONTEXT7_API_KEY:-}" ]; then
        write_context7_secret "$CONTEXT7_API_KEY"
        "$NPX_CMD" -y ctx7@latest setup --claude --mcp --yes --api-key "$CONTEXT7_API_KEY" >/dev/null 2>&1 || echo "Context7 setup failed (non-fatal)"
    else
        "$NPX_CMD" -y ctx7@latest setup --claude --mcp --yes || echo "Context7 setup failed (non-fatal)"
    fi
}

install_claude_mcp
prune_retired_mcps
install_context7

echo "Agent MCPs OK"
