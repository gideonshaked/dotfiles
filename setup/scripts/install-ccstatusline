#!/usr/bin/env bash

set -euo pipefail

if ! command -v npx >/dev/null 2>&1; then
    echo "npx not found, skipping ccstatusline (non-fatal)"
    exit 0
fi

if npx -y --package ccstatusline@latest node -e "process.exit(0)" 2>/dev/null; then
    echo "ccstatusline OK"
else
    echo "ccstatusline install failed (non-fatal)"
fi
