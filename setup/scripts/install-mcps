#!/usr/bin/env bash

set -euo pipefail

SECRETS="${HOME}/.shell-secrets"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
. "$SCRIPT_DIR/lib/path.sh"

# `mcp get` prints the stored command, so matching against it detects a server
# registered from an older definition and forces a re-add.
have() { command -v "$1" >/dev/null 2>&1; }

registered_with() {
    claude mcp get "$1" 2>/dev/null | grep -qF "$2"
}

register() {
    local name="$1"
    shift
    claude mcp remove "$name" -s user >/dev/null 2>&1 || true
    claude mcp add --scope user "$name" "$@" >/dev/null 2>&1 \
        || echo "${name} setup failed (non-fatal)"
}

exa() {
    local url="https://mcp.exa.ai/mcp"
    registered_with exa "URL: $url" && return 0
    register exa --transport http "$url"
}

gcloud_mcp() {
    local package="@google-cloud/gcloud-mcp"
    registered_with gcloud "$package" && return 0
    # bash -lc so npx resolves through the login shell's PATH.
    register gcloud -- bash -lc "exec npx -y $package"
}

# agents/claude/skills/ssh names seven mcp__ssh-mcp__* tools. Without this
# server the skill installs and every tool it references is absent.
ssh_mcp() {
    local package="slepp-ssh-mcp"
    have uvx || {
        echo "uvx not found, skipping ssh-mcp (non-fatal)"
        return 0
    }
    registered_with ssh-mcp "$package" && return 0
    register ssh-mcp -- uvx --from "$package" ssh-mcp
}

# Context7 serves the same HTTP endpoint with or without a key; a key only
# raises the rate limit. Registering it directly avoids `ctx7 setup`, which
# opens an OAuth device flow and waits for a browser that a server does not
# have, ignoring --yes.
context7() {
    local url="https://mcp.context7.com/mcp"

    if [ -n "${CONTEXT7_API_KEY:-}" ]; then
        store_secret CONTEXT7_API_KEY "$CONTEXT7_API_KEY"
        registered_with context7 "Bearer ${CONTEXT7_API_KEY}" && return 0
        register context7 --transport http "$url" \
            --header "Authorization: Bearer ${CONTEXT7_API_KEY}"
    else
        registered_with context7 "URL: $url" && return 0
        register context7 --transport http "$url"
    fi
}

store_secret() {
    local name="$1" value="$2" tmp

    mkdir -p "$(dirname "$SECRETS")"
    touch "$SECRETS"
    chmod 600 "$SECRETS"

    tmp="$(mktemp)"
    grep -v "^export ${name}=" "$SECRETS" >"$tmp" || true
    printf 'export %s=%q\n' "$name" "$value" >>"$tmp"
    mv -f "$tmp" "$SECRETS"
    chmod 600 "$SECRETS"
}

have claude || {
    echo "claude not found, skipping MCPs (non-fatal)"
    exit 0
}

exa
gcloud_mcp
ssh_mcp
context7

echo "MCPs OK"
