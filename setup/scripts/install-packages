#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
. "$SCRIPT_DIR/lib/path.sh"

DOTFILES_DIR="$(cd "$SCRIPT_DIR/../.." && pwd)"
BREWFILE="$DOTFILES_DIR/manifest/Brewfile"
LOCAL_BIN="$HOME/.local/bin"

have() { command -v "$1" >/dev/null 2>&1; }

## macOS ─────────────────────────────────────────────────────────────────────

find_brew() {
    have brew && { command -v brew; return 0; }
    for prefix in /opt/homebrew /usr/local; do
        [ -x "$prefix/bin/brew" ] && { echo "$prefix/bin/brew"; return 0; }
    done
    return 1
}

install_macos() {
    local brew
    brew="$(find_brew || true)"

    if [ -z "$brew" ]; then
        have curl || { echo "curl not found, cannot install Homebrew (non-fatal)"; return 0; }
        echo "Installing Homebrew"
        NONINTERACTIVE=1 /bin/bash -c \
            "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)" \
            || { echo "Homebrew install failed (non-fatal)"; return 0; }
        brew="$(find_brew || true)"
        [ -n "$brew" ] || { echo "no brew binary after install (non-fatal)"; return 0; }
    fi

    eval "$("$brew" shellenv)"
    HOMEBREW_NO_AUTO_UPDATE=1 brew bundle install --file "$BREWFILE" \
        || echo "some packages failed to install (non-fatal)"
}

## Linux ─────────────────────────────────────────────────────────────────────
#
# Homebrew is deliberately not used here. It ships bottles only for
# /home/linuxbrew/.linuxbrew, which needs root to create; at any prefix a user
# can write, every formula is compiled from source. These machines often have
# no sudo, so each tool is fetched as a released binary under $HOME instead.
#
# Only what terminal/shellrc sources is installed. Everything else in the
# Brewfile is a cask or an editor extension, and the steps that want jq or npx
# already skip cleanly when they are absent.

install_starship() {
    have starship && return 0
    curl -fsSL https://starship.rs/install.sh \
        | sh -s -- --yes --bin-dir "$LOCAL_BIN" >/dev/null 2>&1 \
        || echo "starship install failed (non-fatal)"
}

# The installer's --bin mode fetches the binary and nothing else: no shell rc
# edits, which terminal/shellrc handles itself.
install_fzf() {
    have fzf && return 0
    [ -d "$HOME/.fzf" ] || git clone --depth 1 https://github.com/junegunn/fzf "$HOME/.fzf" >/dev/null 2>&1
    "$HOME/.fzf/install" --bin >/dev/null 2>&1 || { echo "fzf install failed (non-fatal)"; return 0; }
    ln -sf "$HOME/.fzf/bin/fzf" "$LOCAL_BIN/fzf"
}

# Without --non-interactive the installer looks for a tty and gives up when
# dotbot runs it without one. It lands in ~/.atuin/bin.
install_atuin() {
    have atuin && return 0
    curl --proto '=https' --tlsv1.2 -LsSf https://setup.atuin.sh \
        | sh -s -- --non-interactive >/dev/null 2>&1 \
        || echo "atuin install failed (non-fatal)"
}

# uv brings uvx, which runs the ssh-mcp server.
install_uv() {
    have uv && return 0
    curl -LsSf https://astral.sh/uv/install.sh | sh >/dev/null 2>&1 \
        || echo "uv install failed (non-fatal)"
}

# A single static binary. install-claude-plugins and the claude-validate hook
# both parse JSON with it.
install_jq() {
    have jq && return 0
    curl -fsSL -o "$LOCAL_BIN/jq" \
        "https://github.com/jqlang/jq/releases/latest/download/jq-linux-${ARCH_GO}" >/dev/null 2>&1 \
        && chmod +x "$LOCAL_BIN/jq" \
        || echo "jq install failed (non-fatal)"
}

# npx runs ccstatusline and the gcloud MCP server. The release index names the
# current LTS, so nothing here pins a version that goes stale. It is read with
# jq, which is why this runs after install_jq.
#
# A distro node is not enough: Ubuntu 24.04 ships v18, and ctx7 needs the JSON
# import attributes added in v20. Presence alone would have skipped this.
NODE_MINIMUM_MAJOR=20

node_new_enough() {
    have node || return 1
    local major
    major="$(node --version 2>/dev/null | sed 's/^v\([0-9]*\).*/\1/')"
    [ -n "$major" ] && [ "$major" -ge "$NODE_MINIMUM_MAJOR" ]
}

install_node() {
    node_new_enough && return 0
    have jq || { echo "jq missing, skipping node (non-fatal)"; return 0; }

    local version url
    version="$(curl -fsSL https://nodejs.org/dist/index.json \
        | jq -r '[.[] | select(.lts != false)][0].version')" || return 0
    [ -n "$version" ] && [ "$version" != null ] || { echo "could not resolve node LTS (non-fatal)"; return 0; }

    url="https://nodejs.org/dist/${version}/node-${version}-linux-${ARCH_NODE}.tar.xz"
    mkdir -p "$HOME/.local/node"
    curl -fsSL "$url" | tar -xJ -C "$HOME/.local/node" --strip-components=1 2>/dev/null \
        || { echo "node install failed (non-fatal)"; return 0; }
    ln -sf "$HOME/.local/node/bin/node" "$HOME/.local/node/bin/npm" \
        "$HOME/.local/node/bin/npx" "$LOCAL_BIN/"
}

install_linux() {
    have curl || { echo "curl not found, cannot install anything (non-fatal)"; return 0; }
    mkdir -p "$LOCAL_BIN"

    case "$(uname -m)" in
        x86_64)  ARCH_GO=amd64; ARCH_NODE=x64 ;;
        aarch64) ARCH_GO=arm64; ARCH_NODE=arm64 ;;
        *)       echo "unsupported architecture $(uname -m) (non-fatal)"; return 0 ;;
    esac

    install_starship
    install_fzf
    install_atuin
    install_uv
    install_jq
    install_node
}

## Both ──────────────────────────────────────────────────────────────────────

# Nothing else installs Claude Code, and the profile links its settings, skills,
# hooks and commands regardless.
install_claude_code() {
    have claude && return 0
    have curl || return 0
    curl -fsSL https://claude.ai/install.sh | bash >/dev/null 2>&1 \
        || echo "Claude Code install failed (non-fatal)"
}

## ───────────────────────────────────────────────────────────────────────────

if [ "$(uname -s)" = Darwin ]; then
    install_macos
else
    install_linux
fi

install_claude_code

echo "packages OK"
