#!/usr/bin/env bash

set -euo pipefail

# macOS: Homebrew installs everything, including the zsh-only plugins that
# terminal/shellrc sources.
if command -v brew >/dev/null 2>&1; then
    TOOLS=(
        fzf-tab
        zsh-autosuggestions
        zsh-syntax-highlighting
        zsh-completions
        starship
        fzf
        atuin
    )
    if HOMEBREW_NO_AUTO_UPDATE=1 brew install "${TOOLS[@]}"; then
        echo "shell tools OK"
    else
        echo "shell tools install failed (non-fatal)"
    fi
    exit 0
fi

# Elsewhere (servers): install starship only. It is the prompt for both shells,
# and without it bash falls back to the bare default. The zsh plugins are not
# installed here; terminal/shellrc guards every source with a file test.
if command -v starship >/dev/null 2>&1; then
    echo "starship already installed"
    exit 0
fi

if ! command -v curl >/dev/null 2>&1; then
    echo "no brew and no curl, skipping shell tools (non-fatal)"
    exit 0
fi

# Official installer, pinned to the user's own prefix so no sudo is needed.
if curl -fsSL https://starship.rs/install.sh \
    | sh -s -- --yes --bin-dir "$HOME/.local/bin" >/dev/null 2>&1; then
    echo "starship installed to ~/.local/bin"
else
    echo "starship install failed (non-fatal, bash falls back to its default prompt)"
fi
