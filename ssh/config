# Include order is precedence order: OpenSSH takes the first value it sees for
# each keyword.
#
#   private.d   untracked hosts. First, so it overrides anything below.
#   config.d    one file per site.
#   platform.d  Host * blocks. Last, so a specific host above wins.
#
# A glob that matches nothing is not an error.

Include ~/.ssh/private.d/*
Include ~/.ssh/config.d/*
Include ~/.ssh/platform.d/*
