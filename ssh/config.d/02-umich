# University of Michigan.

Host psoriasis
	HostName psoriasis.sph.umich.edu
	User gshaked
	PubkeyAuthentication no

Host greatlakes
	HostName greatlakes.arc-ts.umich.edu
	User gshaked
	PubkeyAuthentication no

Host armis2
	HostName armis2.arc-ts.umich.edu
	User gshaked
	PubkeyAuthentication no

Host nubio
	HostName nubio-ssh.gideonshaked.com
	User gshaked
	IdentityFile ~/.ssh/id_ed25519_nubio
	# ProxyCommand inherits the PATH of whatever launched ssh, which for a GUI
	# editor may not include Homebrew. The path is macOS-specific.
	ProxyCommand /opt/homebrew/bin/cloudflared access ssh --hostname %h
