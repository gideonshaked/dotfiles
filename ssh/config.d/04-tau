# Tel Aviv University. These hosts are password-only and drop idle
# connections aggressively.

Host shamir* elkon* davidlasry hagai-shamir3
	PubkeyAuthentication no
	ServerAliveInterval 30
	ServerAliveCountMax 3

# hagai-shamir3 and davidlasry are other people's accounts on these same
# racks, and match neither pattern, so they keep their own User below.
Host shamir* elkon*
	User gshaked

Host shamir3 shamir4 shamir5 shamir6 shamir8
	HostName rack-%h.cs.tau.ac.il

# The rack names zero-pad but the aliases do not, so %h cannot build these.
Host elkon1
	HostName rack-elkon-01.cs.tau.ac.il

Host elkon2
	HostName rack-elkon-02.cs.tau.ac.il

Host elkon3
	HostName rack-elkon-03.cs.tau.ac.il

Host hagai-shamir3
	HostName rack-shamir3.cs.tau.ac.il
	User hagailevi

Host davidlasry
	HostName rack-elkon-03.cs.tau.ac.il
	User davidlasry
