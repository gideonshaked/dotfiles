#
# ~/.zshrc
#

## Shared POSIX configuration: environment, PATH, aliases, ssh-agent, secrets.
[ -f "$HOME/.shell-common" ] && source "$HOME/.shell-common"

## zsh keeps $path deduplicated for the rest of the session
typeset -U path

## ── Options ───────────────────────────────────────────────────────────────

setopt extendedglob              # regular expressions in globs
setopt nocaseglob                # case insensitive globbing
setopt numericglobsort           # sort filenames numerically where sensible
setopt rcexpandparam             # array expansion with parameters
setopt autocd                    # a bare directory path means cd there
setopt nocheckjobs               # no warning about running jobs on exit
setopt nobeep

setopt inc_append_history        # append immediately rather than on exit
setopt histignorealldups         # a repeat replaces the older entry
setopt histignorespace           # a leading space keeps it out of history

HISTSIZE=10000
SAVEHIST=10000

## ── Completion ────────────────────────────────────────────────────────────
## fpath and zstyles must be set before compinit.

fpath=(/opt/homebrew/share/zsh-completions $fpath)

zstyle ':completion:*' matcher-list '' 'm:{a-zA-Z}={A-Za-z}' 'r:|=*' 'l:|=* r:|=*'
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
zstyle ':completion:*' rehash true
zstyle ':completion:*' use-cache on
zstyle ':completion:*' cache-path ~/.cache/zsh
zstyle ':completion:*' menu no   # required by fzf-tab

# -u skips the security check on /opt/homebrew/share, which Homebrew
# intentionally leaves group-writable.
autoload -Uz compinit && compinit -u

## ── Plugins ───────────────────────────────────────────────────────────────
## Order matters: fzf-tab after compinit, syntax-highlighting last.

[ -f /opt/homebrew/share/fzf-tab/fzf-tab.zsh ] && {
    source /opt/homebrew/share/fzf-tab/fzf-tab.zsh
    zstyle ':completion:*:git-checkout:*' sort false
    zstyle ':fzf-tab:complete:cd:*' fzf-preview 'ls -1 --color=always $realpath 2>/dev/null'
    zstyle ':fzf-tab:*' switch-group '<' '>'
}

[ -f /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh ] &&
    source /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh

[ -f /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ] &&
    source /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

## ── Tools ─────────────────────────────────────────────────────────────────

command -v starship >/dev/null 2>&1 && eval "$(starship init zsh)"

# fzf key bindings only: Ctrl-T file picker, Alt-C cd picker. Its completion
# script is skipped deliberately; it rebinds Tab and clashes with fzf-tab.
# Atuin takes over Ctrl-R below.
[ -f /opt/homebrew/opt/fzf/shell/key-bindings.zsh ] &&
    source /opt/homebrew/opt/fzf/shell/key-bindings.zsh

command -v atuin >/dev/null 2>&1 && eval "$(atuin init zsh --disable-up-arrow)"
