# Ghostty-syntax keys that only cmux reads. libghostty rejects them as unknown
# fields, and cmux surfaces every Ghostty diagnostic in an error card, so they
# cannot live in ~/.config/ghostty/config. cmux loads this file after the
# Ghostty config, so anything set here wins.

# Sidebar carries one row per agent, so it reads at a slightly larger size
# than the panes it indexes.
sidebar-font-size = 14
surface-tab-bar-font-size = 11
