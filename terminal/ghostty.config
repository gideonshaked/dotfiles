# Terminal rendering for cmux, which links libghostty and reads this file
# rather than shipping its own renderer config. cmux shows every libghostty
# diagnostic in an error card, so cmux-only keys belong in cmux.json.

font-family = Hack Nerd Font
font-size = 13
theme = Monokai Pro

# Bytes, not lines. An agent run producing a long build log still scrolls back
# to its start.
scrollback-limit = 50000000
