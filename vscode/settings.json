{
	// --- Editor ---
	"editor.accessibilitySupport": "off",
	"editor.defaultFormatter": "vscode.json-language-features",
	"editor.fontFamily": "\"Hack Nerd Font\"",
	"editor.formatOnType": true,
	"editor.minimap.enabled": false,
	"editor.renderControlCharacters": false,
	"editor.semanticHighlighting.enabled": true,
	"editor.semanticTokenColorCustomizations": {
		"enabled": true
	},
	"editor.unicodeHighlight.invisibleCharacters": false,
	"editor.wordWrap": "on",
	"diffEditor.ignoreTrimWhitespace": true,

	// --- Workbench and explorer ---
	"workbench.colorTheme": "Monokai Dimmed",
	"workbench.iconTheme": "material-icon-theme",
	"workbench.startupEditor": "none",
	"workbench.secondarySideBar.defaultVisibility": "hidden",
	"material-icon-theme.folders.theme": "specific",
	"vscode-json-editor.theme": "dark",
	"explorer.confirmDelete": false,
	"explorer.confirmDragAndDrop": false,
	"explorer.confirmPasteNative": false,

	// --- Files ---
	"files.associations": {
		"bash_profile": "shellscript",
		"bashrc": "shellscript",
		"install-starship": "shellscript",
		"install-profile": "shellscript",
		"install-standalone": "shellscript",
		"*.spec": "python",
		"*.rmd": "markdown",
		"identities": "gitconfig",
		"*.format": "plaintext"
	},
	"files.eol": "\n",
	"files.watcherExclude": {
		"**/hpos/**": true,
		"**/node_modules/**": true,
		"**/output_data*/**": true,
		"**/public/**": true
	},

	// --- Terminal ---
	"terminal.integrated.enableMultiLinePasteWarning": false,
	"terminal.integrated.inheritEnv": false,

	// --- Git ---
	"git.autofetch": true,
	"git.confirmSync": false,
	"git.enableSmartCommit": true,
	"git.ignoreLegacyWarning": true,
	"git.ignoreRebaseWarning": true,
	"git.openRepositoryInParentFolders": "never",

	// --- AI assistants ---
	"chat.editing.alwaysSaveWithGeneratedChanges": true,
	"chat.editing.confirmEditRequestRemoval": false,
	"chat.editing.confirmEditRequestRetry": false,
	"claudeCode.preferredLocation": "sidebar",
	"claudeCode.useTerminal": true,
	"editor.pasteAs.preferences": [
		"chat.attach.text"
	],
	"github.copilot.editor.enableAutoCompletions": true,
	"github.copilot.nextEditSuggestions.enabled": true,
	"github.copilot.selectedCompletionModel": "gpt-4o-copilot",

	// --- Python ---
	"[snakemake]": {
		"editor.defaultFormatter": "tfehlmann.snakefmt"
	},
	"black-formatter.args": [
		"--line-length",
		"88"
	],
	"python.createEnvironment.trigger": "off",
	"python.defaultInterpreterPath": "/opt/homebrew/bin/python3",
	"python.languageServer": "Pylance",
	"python.terminal.activateEnvironment": false,

	// --- Notebooks ---
	"jupyter.askForKernelRestart": false,
	"notebook.cellExecutionTimeVerbosity": "verbose",
	"notebook.cellToolbarLocation": {
		"default": "right",
		"jupyter-notebook": "left"
	},
	"notebook.confirmDeleteRunningCell": false,
	"notebook.formatOnCellExecution": true,
	"notebook.formatOnSave.enabled": true,

	// --- R ---
	"[r]": {
		"editor.defaultFormatter": "REditorSupport.r"
	},
	"r.lsp.diagnostics": false,

	// --- Shell scripts ---
	"bashIde.shellcheckPath": "~/bin/shellcheck",
	"shellcheck.customArgs": [
		"--shell bash"
	],
	"shellcheck.executablePath": "/opt/homebrew/bin/shellcheck",

	// --- LaTeX ---
	"[latex]": {
		"editor.defaultFormatter": "James-Yu.latex-workshop"
	},
	"latex-utilities.countWord.format": "${words} Words, ${chars} Chars",
	"latex-utilities.message.update.show": false,
	"latex-workshop.formatting.latex": "latexindent",
	"latex-workshop.linting.chktex.enabled": true,
	"latex-workshop.linting.chktex.exec.args": [
		"-wall",
		"-n22",
		"-n30",
		"-e16",
		"-q",
		"-n46",
		"-n3",
		"-n45"
	],
	"latex-workshop.view.pdf.viewer": "tab",
	"latex.formatter.path": "/opt/homebrew/bin/latexindent",
	"latex.linter.enabled": false,

	// --- Markdown ---
	"[markdown]": {
		"editor.defaultFormatter": "DavidAnson.vscode-markdownlint"
	},
	"markdownlint.config": {
		"MD033": false
	},

	// --- JSON and YAML ---
	"[jsonc]": {
		"editor.defaultFormatter": "vscode.json-language-features"
	},
	"[yaml]": {
		"editor.defaultFormatter": "redhat.vscode-yaml"
	},
	"yaml.disableSchemaDetection": [
		"**/.github/workflows/*.yml",
		"**/.github/workflows/*.yaml",
		"**/.gitea/workflows/*.yml",
		"**/.gitea/workflows/*.yaml",
		"**/.forgejo/workflows/*.yml",
		"**/.forgejo/workflows/*.yaml"
	],

	// --- Docker ---
	"docker.extension.dockerEngineAvailabilityPrompt": false,
	"docker.extension.enableComposeLanguageServer": false,

	// --- Remote SSH ---
	"remote.SSH.connectTimeout": 90,
	"remote.SSH.lockfilesInTmp": true,
	"remote.SSH.logLevel": "trace",
	"remote.SSH.remotePlatform": {
		"nubio": "linux",
		"genomicsbench": "linux",
		"omicsbench": "linux"
	},
	"remote.SSH.showLoginTerminal": true,
	"remote.SSH.useExecServer": false,
	"remote.SSH.useLocalServer": false,

	// --- Build and debug ---
	"debug.onTaskErrors": "abort",
	"lldb.suppressUpdateNotifications": true,
	"makefile.configureOnOpen": true,

	// --- Noise and telemetry ---
	"redhat.telemetry.enabled": false,
	"security.workspace.trust.enabled": false,
	"update.showReleaseNotes": false
}
